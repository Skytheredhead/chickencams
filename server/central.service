[Unit]
Description=Chickencams central server
After=network.target

[Service]
Type=simple
User=__CHICKENCAMS_USER__
Group=__CHICKENCAMS_GROUP__
WorkingDirectory=__CHICKENCAMS_WORKDIR__
ExecStart=__CHICKENCAMS_NODE__ server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
