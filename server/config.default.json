{
  "server": {
    "port": 7979,
    "host": "0.0.0.0"
  },
  "paths": {
    "streamsRoot": "./streams",
    "recordingsRoot": "./recordings",
    "activityRoot": "./activity",
    "cameraRegistryPath": "./server/camera-registry.json",
    "dbPath": "./server/index.db"
  },
  "ingestHost": "0.0.0.0",
  "mediamtx": {
    "binary": "mediamtx",
    "configPath": "./server/mediamtx.runtime.yml",
    "templatePath": "./server/mediamtx.yml",
    "apiUrl": "http://127.0.0.1:9997",
    "webrtcPort": 8889,
    "hlsPort": 8888,
