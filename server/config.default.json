  "cameras": [
    { "id": "cam1", "name": "Cam 1", "enabled": true, "srtPort": 9001 },
    { "id": "cam2", "name": "Cam 2", "enabled": true, "srtPort": 9002 },
    { "id": "cam3", "name": "Cam 3", "enabled": true, "srtPort": 9003 },
    { "id": "cam4", "name": "Cam 4", "enabled": true, "srtPort": 9004 },
